# 统一换行符策略，避免跨平台检出后脚本失效
# Windows 批处理必须是 CRLF，否则 cmd.exe 解析会出错（中文乱码、行结构被破坏）
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell 脚本必须是 LF
*.sh text eol=lf

# 文本文件统一按 LF 存储
*.py     text
*.md     text
*.json   text
*.toml   text
*.txt    text
*.yml    text
*.yaml   text

# 二进制文件不做换行转换
*.db     binary
*.png    binary
*.jpg    binary
*.pdf    binary
*.faiss  binary
*.pkl    binary
*.bin    binary
