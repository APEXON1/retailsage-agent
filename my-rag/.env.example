# ==================== SMTP 邮箱验证码配置（可选） ====================
# 复制本文件为 .env 并填入真实值，即可开启「注册验证码真实发送邮件」。
# 不配置（或配置缺失）时，系统自动降级为演示模式：验证码直接显示在注册页面上。
#
# QQ 邮箱获取方式：设置 → 账号 → 开启 IMAP/SMTP 服务 → 生成 16 位授权码（非登录密码）
# 163 邮箱同理：设置 → POP3/SMTP/IMAP → 开启服务 → 获取授权码

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_name@qq.com
SMTP_PASS=your_16_digit_authcode
SMTP_FROM=your_name@qq.com
